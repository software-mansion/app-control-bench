# Immich benchmark surface — FROZEN environment (app-control-bench)
# Copy to `.env` next to docker-compose.yml before `docker compose up -d`.
# Values here are for a LOCAL, disposable benchmark server on the radoniusz LAN only
# (never exposed to the internet), so the demo DB password is fine to keep.

# Uploaded originals + thumbnails (bind mount, relative to the compose dir).
UPLOAD_LOCATION=./library

# Postgres data dir (bind mount, relative to the compose dir).
DB_DATA_LOCATION=./postgres

# Timezone of the benchmark machine (drives "on this day" / memory day boundaries).
TZ=Europe/Warsaw

# ── FROZEN VERSION ────────────────────────────────────────────────────────────
# Pinned to the v3.0.1 stable release (published 2026-07-02). Do NOT use "v3" /
# "release" here — those are rolling tags and would break the freeze. postgres and
# valkey are digest-pinned inside docker-compose.yml, so this single line pins the
# whole app surface. See docs/surfaces/immich-frozen.md for the resolved image digests.
IMMICH_VERSION=v3.0.1

# Postgres credentials (local bench only).
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
