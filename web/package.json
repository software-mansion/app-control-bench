{
  "name": "app-control-bench-report",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:data": "python3 ../runner/report_data.py --results ../results --out ../public",
    "build:assets": "npm run clean && npm run generate:data && vite build --config vite.config.ts && vite build --config vite.config.ssr.ts",
    "prerender": "node .vite-ssr/prerender.js ..",
    "build": "npm run build:assets && npm run prerender",
    "clean": "rm -rf ../public/assets ../public/.vite .vite-ssr ../public/index.html ../public/index-runs.html ../public/index-telemetry.html ../public/e ../public/og.png ../public/favicon.svg ../public/robots.txt ../public/sitemap.xml",
    "check": "python3 ../runner/check_theme.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.9.3",
    "unplugin-typegpu": "^0.11.6",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@typegpu/noise": "^0.11.0",
    "preact": "^10.27.2",
    "preact-render-to-string": "^6.6.2",
    "typegpu": "^0.11.9"
  }
}
